# Copie para .env e preencha. O .env nunca é versionado (.gitignore).
# Variáveis de ambiente do sistema com o mesmo nome têm prioridade sobre o .env.

# Servidor de origem dos backups (FTP/SFTP)
ORIGEM_USER=
ORIGEM_PASSWORD=

# Servidor Oracle (SSH/SFTP)
ORACLE_SSH_USER=oracle
ORACLE_SSH_PASSWORD=

# Usuário do Data Pump (impdp)
IMPDP_USER=system
IMPDP_PASSWORD=

# Opcional: webhook (Workflows) do canal do Teams para alertas e resumo diário
TEAMS_WEBHOOK_URL=
